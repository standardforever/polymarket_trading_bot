# Copy to .env and fill locally. Environment variables override this file.
# Lowercase api_key, api_secret and api_passphrase aliases are also accepted.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Manual real-money trading. Secrets stay in the API process and are never sent
# to the browser. POLYMARKET_WALLET is the address that holds your Polymarket
# balance. Leave it blank only when the signer address itself holds the funds.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET=
